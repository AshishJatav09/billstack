# BillStack Frontend Production Environment Template
# Copy to .env.production during deployment/build and fill real public values.
# Vite variables are bundled into the browser. Do not put backend secrets here.

VITE_API_BASE_URL=https://api.example.com/api
VITE_GOOGLE_CLIENT_ID=
VITE_BILLSTACK_DEPLOYMENT_MODE=SAAS
VITE_POWERED_BY_TEXT=Powered by Nemnidhi Digital Solutions
